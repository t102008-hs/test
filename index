  </nav>
  
  <!-- ================= 3. 主內容區塊 ================= -->
  <div class="flex-1 flex flex-col min-h-screen md:ml-64 md:p-6 pb-28 md:pb-6">
    <div class="md:bg-white/60 md:backdrop-blur-2xl md:rounded-[2.5rem] md:shadow-xl md:border md:border-white/50 flex-1 flex flex-col overflow-hidden relative">
      <header id="top-header" class="sticky top-0 z-30 transition-transform duration-300 bg-milktea/90 md:bg-white/60 backdrop-blur-md pt-safe">
        <div class="w-full max-w-7xl mx-auto px-4 md:px-8 flex items-center justify-between py-4">
          <div class="flex space-x-3 hide-scroll-x flex-1 items-center" id="category-tabs"></div>
        </div>
      </header>
      
      <div id="subcat-grid" class="p-4 md:p-8 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-6 max-w-7xl mx-auto w-full pb-8" style="display:none;"></div>
      <main id="article-list" class="p-4 md:p-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-7xl mx-auto w-full pb-8" style="display:none;"></main>
    </div>
  </div>
  
<!-- 🌟 新版：左右分欄閱讀彈窗 (結合 Fancybox) -->
<!-- 🌟 新版：左右分欄閱讀彈窗 (修復手機滾動與縮圖對齊) -->
  <div id="article-modal" class="fixed inset-0 z-[100] hidden bg-black/60 backdrop-blur-sm items-center justify-center p-4 md:p-8 transition-opacity duration-300 opacity-0">
    <!-- 關鍵修正 1：開放 overflow-y-auto 讓手機版內容過長時可自由滾動 -->
    <div id="modal-inner" class="bg-white/95 backdrop-blur-md rounded-[2rem] max-w-5xl w-full max-h-[90vh] overflow-y-auto md:overflow-hidden relative shadow-2xl flex flex-col md:flex-row transition-transform duration-300 scale-95 border border-white">
      
      <!-- 關閉按鈕 -->
      <button onclick="closeModal()" class="absolute top-4 right-4 md:top-6 md:right-6 bg-gray-100/80 hover:bg-gray-200 text-gray-500 hover:text-gray-800 rounded-full w-10 h-10 flex items-center justify-center text-xl transition z-[60] shadow-sm shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>

      <!-- 左側：主圖視覺區 (手機版限制最大高度，避免卡掉文字) -->
      <div id="modal-left-panel" class="w-full md:w-2/5 max-h-[35vh] md:max-h-none bg-gray-50/50 flex flex-col items-center justify-center p-4 md:p-8 border-b md:border-b-0 md:border-r border-gray-200/50 relative overflow-hidden shrink-0">
        <div id="modal-main-media-container" class="w-full h-full flex items-center justify-center relative">
          <!-- JS 會把主圖塞在這裡 -->
        </div>
      </div>

      <!-- 右側：圖文與縮圖區 -->
      <div class="w-full md:w-3/5 flex flex-col p-5 md:p-10 md:overflow-y-auto min-h-0 relative flex-1">
        <div class="mb-2">
          <span id="modal-category" class="text-sm md:text-base font-bold text-morandi-dark bg-morandi-light/80 px-3.5 py-1 rounded-full inline-block tracking-wide"></span>
        </div>
        
        <!-- 標題 -->
        <h2 id="modal-title" class="text-2xl md:text-3xl font-bold text-morandi-dark mb-2 leading-snug"></h2>
        
        <!-- 作者與日期 (條件式顯示) -->
        <div id="modal-meta-box" class="flex items-center gap-4 mb-4 border-b border-gray-100 pb-3 text-sm md:text-base font-bold text-gray-400">
          <span id="modal-author"></span>
          <span id="modal-date"></span>
        </div>

        <!-- 內文 (若沒內容會自動隱藏) -->
        <div id="modal-content" class="text-gray-700 whitespace-pre-wrap leading-relaxed text-base md:text-lg mb-6 flex-1"></div>
        
        <!-- 底部微縮圖列 -->
        <div id="modal-gallery-container" class="mt-auto pt-4 border-t border-gray-100 hidden">
          <!-- 關鍵修正 2：使用 grid-cols-4 讓縮圖齊平 4 等分填滿，消除右側空缺 -->
          <div id="modal-gallery" class="grid grid-cols-4 sm:grid-cols-5 gap-2 md:gap-3 w-full">
             <!-- JS 會把其餘縮圖塞在這裡 -->
          </div>
        </div>
      </div>

    </div>
  </div>
  
<!-- ================= 5. Lightbox 圖片與影片全螢幕放大 ================= -->
  <div id="lightbox" class="fixed inset-0 z-[70] bg-black flex flex-col items-center justify-center opacity-0 transition-opacity duration-300" style="display:none;">
    <button id="btn-close-lightbox" class="absolute top-5 right-5 text-white p-3 z-30 bg-white/15 rounded-full hover:bg-white/25 transition active:scale-90 shadow-lg"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg></button>
    <div id="lightbox-counter" class="absolute top-7 left-6 text-white/80 font-bold z-30 text-sm tracking-widest drop-shadow-md"></div>
    <button id="btn-prev-img" class="absolute left-4 text-white p-4 z-30 opacity-50 hover:opacity-100 hidden md:block bg-white/10 rounded-full transition"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg></button>
    <button id="btn-next-img" class="absolute right-4 text-white p-4 z-30 opacity-50 hover:opacity-100 hidden md:block bg-white/10 rounded-full transition"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></button>
    
    <!-- 主顯示區：照片模式保留上下邊距，影片模式將動態切換為 100% 滿版全螢幕 -->
    <div id="lightbox-main-area" class="w-full h-full flex items-center justify-center overflow-hidden pb-32 px-3 md:px-8 pt-20">
      <img id="lightbox-img" src="" draggable="false" class="max-w-full max-h-full object-contain rounded-2xl shadow-2xl select-none pointer-events-auto touch-none" style="transform: scale(0.95); transition: transform 0.3s ease;">
      <div id="lightbox-video-box" class="relative w-full h-full flex items-center justify-center pointer-events-auto" style="display:none;"></div>
    </div>
    
    <div id="lightbox-caption" class="absolute bottom-[100px] w-full flex justify-center px-4 z-30 pointer-events-none"><span class="inline-block bg-black/40 backdrop-blur-md text-white/95 text-sm md:text-base font-medium tracking-widest px-5 py-2 rounded-full shadow-sm border border-white/20 transition-opacity duration-300" id="lightbox-caption-text"></span></div>
    <div id="lightbox-thumbnails" class="absolute bottom-6 w-full flex justify-center space-x-2 px-4 overflow-x-auto hide-scroll-x z-30"></div>
  </div>

  <script>
    var globalArticles = []; 
    var currentMainCategory = '行政'; 
    var currentSubCategory = '';
    var currentGalleryData = []; 
    var currentLightboxIndex = 0;
    var imgScale = 1, imgTranslateX = 0, imgTranslateY = 0;
    var lastTouchTime = 0, touchStartDistance = 0, isPinching = false, lastTouchX = 0, lastTouchY = 0;
    var lastScrollTop = 0;
    
window.addEventListener('scroll', function() {
      // 🌟 加入這行：如果螢幕寬度大於等於 768px (電腦版/平板)，直接跳出不執行隱藏
      if (window.innerWidth >= 768) return;
      
      var st = window.pageYOffset || document.documentElement.scrollTop;
      var bottomNav = document.getElementById('bottom-nav');
      if (st > lastScrollTop && st > 60) { 
        bottomNav.classList.add('translate-y-[150%]'); 
      } else { 
        bottomNav.classList.remove('translate-y-[150%]'); 
      }
      lastScrollTop = st <= 0 ? 0 : st;
    }, false);

    function resetImageTransform() { 
      imgScale = 1; imgTranslateX = 0; imgTranslateY = 0; 
      var img = document.getElementById('lightbox-img'); 
      if (img) { 
        img.style.transition = 'transform 0.3s ease'; 
        img.style.transform = 'translate(0px, 0px) scale(1)'; 
      } 
    }

    document.addEventListener('click', function(e) {
      if (e.target.closest('#btn-start-reading')) { 
        document.getElementById('splash-screen').style.opacity = '0'; 
        setTimeout(function() { document.getElementById('splash-screen').style.display = 'none'; }, 500); 
        return; 
      }
      var navBtn = e.target.closest('.nav-btn');
      if (navBtn) {
        var targetCat = '';
        if (navBtn.id === 'nav-admin') targetCat = '行政'; 
        else if (navBtn.id === 'nav-lower') targetCat = '低年級'; 
        else if (navBtn.id === 'nav-middle') targetCat = '中年級'; 
        else if (navBtn.id === 'nav-upper') targetCat = '高年級'; 
        else if (navBtn.id === 'nav-kinder') targetCat = '星光班及幼兒園';
        if (targetCat) {
            setMainCategory(targetCat, navBtn.id); 
            // 🌟 點擊底部主分類時，自動捲動回最上方
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        return;
      }
      var filterBtn = e.target.closest('.filter-btn'); 
      if (filterBtn) { 
          setSubCategory(filterBtn.innerText); 
          // 🌟 點擊上方子分類標籤時，也自動捲動回最上方
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return; 
      }
      
      var subCatCard = e.target.closest('.sub-cat-card'); 
      if (subCatCard) { setSubCategory(subCatCard.querySelector('.cat-name').innerText); return; }
      
      var card = e.target.closest('.article-card'); 
      if (card) { openModal(card.id.replace('article-', '')); return; }
      
      //var thumb = e.target.closest('.gallery-thumb'); 
      //if (thumb) { openLightbox(parseInt(thumb.id.replace('thumb-', ''), 10)); return; }
      
      var lbThumb = e.target.closest('[id^="lb-thumb-"]'); 
      if (lbThumb) { currentLightboxIndex = parseInt(lbThumb.id.replace('lb-thumb-', ''), 10); updateLightboxImage(); return; }
      
      if (e.target.id === 'article-modal') { closeModal(); return; } 
      if (e.target.id === 'lightbox') { closeLightbox(); return; }
      if (e.target.closest('#btn-close-modal')) closeModal(); 
      if (e.target.closest('#btn-close-lightbox')) closeLightbox();
      if (e.target.closest('#btn-prev-img')) prevImage(); 
      if (e.target.closest('#btn-next-img')) nextImage();
    });

    var touchStartX = 0, touchStartY = 0, touchStartScrollTop = 0;
    document.addEventListener('touchstart', function(e) { 
      touchStartX = e.changedTouches[0].clientX; 
      touchStartY = e.changedTouches[0].clientY; 
      var modalInner = document.getElementById('modal-inner'); 
      if (modalInner) touchStartScrollTop = modalInner.scrollTop; 
    }, {passive: true});
    
    document.addEventListener('touchend', function(e) {
      var diffX = e.changedTouches[0].clientX - touchStartX; 
      var diffY = e.changedTouches[0].clientY - touchStartY;
      var lb = document.getElementById('lightbox');
      if (lb && lb.style.display !== 'none') {
        if (imgScale > 1) return;
        if (diffY > 80 && Math.abs(diffY) > Math.abs(diffX)) { closeLightbox(); } 
        else if (Math.abs(diffY) < 60) { 
          if (diffX < -50) nextImage(); 
          if (diffX > 50) prevImage(); 
        } 
        return;
      }
      var modal = document.getElementById('article-modal');
      if (modal && modal.style.display !== 'none') {
        if (Math.abs(diffY) < 60 && Math.abs(diffX) > 80) { closeModal(); return; }
        if (diffY > 80 && Math.abs(diffY) > Math.abs(diffX) && touchStartScrollTop <= 0) { closeModal(); return; }
      }
    }, {passive: true});

    // ==========================================
    // 新增防護罩與解析媒體
    // ==========================================
    function escapeHTML(str) {
      if (!str) return '';
      return String(str).replace(/[&<>'"]/g, function(tag) {
        var charsToReplace = { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' };
        return charsToReplace[tag] || tag;
      });
    }

    function parseMediaItem(rawItem) {
      if (!rawItem || typeof rawItem !== 'string') return null;
      var parts = rawItem.split('|||');
      var url = parts[0].trim();
      var caption = parts.length > 1 ? escapeHTML(parts[1].trim()) : ''; 
      if (!url) return null;

      var ytMatch = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=|shorts\/)|youtu\.be\/)([^"&?\/\s]{11})/);
      if (ytMatch && ytMatch[1]) {
        var ytId = ytMatch[1];
        return {
          type: 'youtube',
          embedUrl: 'https://www.youtube.com/embed/' + ytId + '?rel=0&autoplay=1&playsinline=0&fs=1',
          thumbUrl: 'https://img.youtube.com/vi/' + ytId + '/hqdefault.jpg',
          caption: caption
        };
      }
      
      var cleanUrl = url.replace('#video', '');
      var driveMatch = cleanUrl.match(/\/d\/([a-zA-Z0-9_-]+)/) || cleanUrl.match(/id=([a-zA-Z0-9_-]+)/);
      var safeImgUrl = (driveMatch && driveMatch[1]) ? 'https://lh3.googleusercontent.com/d/' + driveMatch[1] : cleanUrl;
      return {
        type: 'image',
        url: safeImgUrl,
        thumbUrl: safeImgUrl,
        caption: caption
      };
    }

    function sortSubCategories(subs) {
      var orderMap = { '校長': 1, '家長會長': 2, '教務處': 3, '學務處': 4, '總務處': 5, '輔導室': 6, '忠班': 11, '孝班': 12, '仁班': 13, '愛班': 14, '信班': 15, '義班': 16, '和班': 17, '藍鯨班': 21, '海馬班': 22, '珊瑚班': 23, '海豚班': 24, '星光班': 25 };
      return subs.sort(function(a, b) {
        var weightA = 999, weightB = 999;
        for (var key in orderMap) { if (a.indexOf(key) !== -1) weightA = orderMap[key]; }
        for (var key in orderMap) { if (b.indexOf(key) !== -1) weightB = orderMap[key]; }
        if (weightA !== weightB) return weightA - weightB; 
        return a.localeCompare(b, 'zh-TW', { numeric: true });
      });
    }

    window.onload = function() {
      // ⚠️ 記得換成你的完全公開版 API 網址！
      var API_URL = 'https://script.google.com/macros/s/AKfycbx0WYcfguRrU0oj-BMRjnwrz6LySteDiy7ZMuF4WnaoKFJoqtL3nF3Bpe0M7bm2PG9Z/exec?api=true'; 
      var loadingEl = document.getElementById('splash-loading'); 
      if (loadingEl) loadingEl.style.display = 'flex';
      
      fetch(API_URL)
        .then(function(res) { return res.json(); })
        .then(function(data) { initApp(data); })
        .catch(function(err) { showError(err); });

      var lbImg = document.getElementById('lightbox-img');
      if (lbImg) {
        lbImg.addEventListener('dblclick', function(e) { 
          if (imgScale > 1) { resetImageTransform(); } 
          else { imgScale = 2.5; lbImg.style.transition = 'transform 0.3s ease'; lbImg.style.transform = 'translate(0px, 0px) scale(' + imgScale + ')'; } 
        });
        lbImg.addEventListener('touchstart', function(e) {
          if (e.touches.length === 1) {
            var tapLength = new Date().getTime() - lastTouchTime;
            if (tapLength < 300 && tapLength > 0) { 
              e.preventDefault(); 
              if (imgScale > 1) { resetImageTransform(); } 
              else { imgScale = 2.5; lbImg.style.transition = 'transform 0.3s ease'; lbImg.style.transform = 'translate(0px, 0px) scale(' + imgScale + ')'; } 
            } else { 
              lbImg.style.transition = 'none'; 
              lastTouchX = e.touches[0].clientX; 
              lastTouchY = e.touches[0].clientY; 
            }
            lastTouchTime = new Date().getTime();
          } else if (e.touches.length === 2) { 
            e.preventDefault(); 
            isPinching = true; 
            lbImg.style.transition = 'none'; 
            touchStartDistance = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY); 
          }
        }, {passive: false});
        lbImg.addEventListener('touchmove', function(e) {
          if (e.touches.length === 1 && imgScale > 1 && !isPinching) {
            e.preventDefault(); e.stopPropagation();
            imgTranslateX += e.touches[0].clientX - lastTouchX; 
            imgTranslateY += e.touches[0].clientY - lastTouchY;
            lastTouchX = e.touches[0].clientX; 
            lastTouchY = e.touches[0].clientY;
            lbImg.style.transform = 'translate(' + imgTranslateX + 'px, ' + imgTranslateY + 'px) scale(' + imgScale + ')';
          } else if (e.touches.length === 2) {
            e.preventDefault(); e.stopPropagation();
            var curDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
            imgScale = Math.min(Math.max(1, imgScale * (curDist / touchStartDistance)), 5); 
            touchStartDistance = curDist;
            lbImg.style.transform = 'translate(' + imgTranslateX + 'px, ' + imgTranslateY + 'px) scale(' + imgScale + ')';
          }
        }, {passive: false});
        lbImg.addEventListener('touchend', function(e) { 
          if (e.touches.length < 2) isPinching = false; 
          if (imgScale < 1) resetImageTransform(); 
        }, {passive: true});
      }
    };

    function initApp(articles) {
      articles.forEach(function(a, idx) { if (!a.id) a.id = 'auto-' + idx; }); 
      globalArticles = articles;
      document.getElementById('splash-loading').style.display = 'none'; 
      document.getElementById('btn-start-reading').style.display = 'block'; 
      setMainCategory('行政', 'nav-admin');
    }

    function setMainCategory(mainCat, activeNavId) {
      currentMainCategory = mainCat; 
      currentSubCategory = '';
      document.querySelectorAll('.nav-btn').forEach(function(btn) {
        btn.classList.remove('text-morandi-dark', 'md:bg-white/60', 'md:bg-white/70', 'text-gray-400', 'md:hover:bg-white/40');
        if (btn.id === activeNavId) { 
          btn.classList.add('text-morandi-dark', 'md:bg-white/70'); 
        } else { 
          btn.classList.add('text-gray-400', 'md:hover:bg-white/40'); 
        }
      });
      var subs = []; 
      globalArticles.forEach(function(a) { 
        if (a.main_category === mainCat && a.sub_category && !subs.includes(a.sub_category)) subs.push(a.sub_category); 
      });
      var sortedSubs = sortSubCategories(subs);
      renderTabs(sortedSubs); 
      renderSubCategoryGrid(sortedSubs);
    }

    function setSubCategory(subCat) {
      currentSubCategory = subCat; 
      var subs = [];
      globalArticles.forEach(function(a) { 
        if (a.main_category === currentMainCategory && a.sub_category && !subs.includes(a.sub_category)) subs.push(a.sub_category); 
      });
      renderTabs(sortSubCategories(subs)); 
      filterArticles();
    }

    function renderTabs(categories) {
      var container = document.getElementById('category-tabs'); 
      container.innerHTML = '';
      if (categories.length === 0) { container.style.display = 'none'; return; }
      container.style.display = 'flex';
      categories.forEach(function(cat) {
        var btn = document.createElement('button');
        var style = (cat === currentSubCategory) ? 'bg-morandi-dark text-white shadow-md' : 'bg-white text-gray-500 border border-white/50 hover:bg-morandi-light hover:text-morandi-dark shadow-sm';
        btn.className = 'filter-btn whitespace-nowrap px-5 py-2 rounded-full text-sm font-bold tracking-wide transition-colors ' + style;
        btn.innerText = cat; 
        container.appendChild(btn);
      });
    }

    function renderSubCategoryGrid(subs) {
      var gridContainer = document.getElementById('subcat-grid'); 
      var listContainer = document.getElementById('article-list');
      listContainer.style.display = 'none'; 
      gridContainer.style.display = 'grid'; 
      gridContainer.innerHTML = '';
      if (subs.length === 0) { 
        gridContainer.style.display = 'block'; 
        gridContainer.innerHTML = '<div class="text-center p-8 bg-white/60 rounded-3xl border border-white mt-12 shadow-sm"><p class="text-gray-500 font-bold text-lg">這個分類目前沒有內容喔！</p></div>'; 
