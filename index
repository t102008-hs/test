    <p class="text-morandi-dark/80 mb-12 text-lg font-medium tracking-widest bg-morandi-light/50 px-5 py-1.5 rounded-full">探索校園美好點滴</p>
    <div id="splash-loading" class="flex flex-col items-center">
      <svg class="animate-spin h-8 w-8 text-morandi-dark mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
      <p class="text-morandi-dark/60 font-medium tracking-widest">系統載入中...</p>
    </div>
    <button id="btn-start-reading" class="bg-morandi-dark text-white px-10 py-4 rounded-full shadow-lg font-bold text-lg tracking-wider hover:opacity-90 hover:scale-105 transition active:scale-95" style="display:none;">開始閱讀</button>
  </div>
  
  <!-- ================= 2. 導覽列 ================= -->
  <nav id="bottom-nav" class="fixed z-50 transition-transform duration-300 ease-in-out
              bottom-6 left-1/2 -translate-x-1/2 w-[92%] max-w-[420px] bg-white/85 backdrop-blur-xl border border-white/60 rounded-full shadow-[0_8px_30px_rgba(0,0,0,0.12)] px-2 py-2 flex justify-between items-center
              md:bottom-auto md:left-0 md:translate-x-0 md:w-64 md:h-screen md:rounded-none md:border-t-0 md:border-r md:border-white/40 md:bg-transparent md:shadow-none md:px-6 md:pt-12 md:flex-col md:justify-start md:items-stretch">
    
    <div class="hidden md:block mb-10 text-center md:text-left">
      <h1 class="text-2xl font-extrabold text-morandi-dark tracking-wider">香山國小</h1>
      <h2 class="text-sm font-bold text-morandi-dark/80 tracking-widest mt-1">數位校刊</h2>
