<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css" />
  <title>香山國小數位校刊</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            milktea: '#F4ECE4',
            cardBg: 'rgba(255, 255, 255, 0.75)',
            morandi: { taupe: '#B4968F', pink: '#F58595', dark: '#7A635E', light: '#E8DEDC' }
          }
        }
      }
    }
  </script>
  <style>
    .article-content { white-space: pre-wrap; }
    ::-webkit-scrollbar { display: none; }
    .hide-scroll-x { overflow-x: auto; -ms-overflow-style: none; scrollbar-width: none; }
    body.modal-open { overflow: hidden; }
    .pb-safe { padding-bottom: env(safe-area-inset-bottom, 16px); }
    .pt-safe { padding-top: env(safe-area-inset-top, 0px); }
  </style>
</head>
<script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>
<script>
  // 初始化 Fancybox，這樣綁定特定屬性的圖片就會自動具備燈箱功能
  document.addEventListener("DOMContentLoaded", function() {
    Fancybox.bind('[data-fancybox]', {
      // 可以在這裡設定動畫或其他參數
      Thumbs: { type: "modern" },
    });
  });

  // 🌟 修復 4：保護文章彈窗，全螢幕燈箱關閉時只關閉自己
    Fancybox.bind("[data-fancybox]", {
      closeExisting: false,
      hideScrollbar: false,
      touch: false // 防止手機下滑圖片時誤把背景彈窗關掉
    });
</script>  
<body class="bg-milktea min-h-[100dvh] text-gray-800 font-sans relative md:flex overflow-x-hidden transition-colors duration-500">
  
  <!-- ================= 1. 歡迎頁 ================= -->
  <div id="splash-screen" class="fixed inset-0 z-[100] bg-milktea flex flex-col items-center justify-center transition-opacity duration-500">
