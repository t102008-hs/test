// ==========================================
    // 3. 閱讀彈窗 (智慧判斷：依據有無內文決定版型，無內文時完美同行)
    // ==========================================
    function openModal(articleId) {
      var article = globalArticles.find(function(a) { return String(a.id) === String(articleId); }); 
      if(!article) return;
      
      document.getElementById('modal-category').innerText = article.sub_category || article.main_category || '未分類';
      var catContainer = document.getElementById('modal-category').parentElement;
      
      var modalTitle = document.getElementById('modal-title');
      var safeTitle = escapeHTML(article.title || '');
      var safeAuthor = escapeHTML(article.author || '');
      
      if (safeTitle || safeAuthor) {
          var titleHtml = safeTitle;
          if (safeAuthor) {
              titleHtml += '<span class="text-base md:text-lg font-normal text-gray-400 ml-2"> 作者 / ' + safeAuthor + '</span>';
          }
          modalTitle.innerHTML = titleHtml;
          modalTitle.style.display = 'block';
      } else {
          modalTitle.style.display = 'none';
      }
      
      var dateStr = article.publish_date || '';
      document.getElementById('modal-date').innerText = dateStr;
      var metaBox = document.getElementById('modal-meta-box');
      if (!dateStr) { metaBox.style.display = 'none'; } else { metaBox.style.display = 'flex'; }
      
      var safeContent = escapeHTML(article.content || '').trim();
      var hasContent = !!safeContent;
      var contentEl = document.getElementById('modal-content');
      if (hasContent) {
          contentEl.innerHTML = safeContent.replace(/\n/g, '<br>');
          contentEl.style.display = 'block';
      } else {
          contentEl.style.display = 'none';
      }
      
      var mediaItems = [];
      if (article.gallery) {
        var items = String(article.gallery).split(/[\n,]+/).map(function(u) { return u.trim(); }).filter(function(u) { return u; });
        items.forEach(function(item) {
          var parsed = parseMediaItem(item);
          if (parsed) mediaItems.push(parsed);
        });
      }
      var hasGallery = mediaItems.length > 1;
      
      var modalInner = document.getElementById('modal-inner');
      var leftPanel = document.getElementById('modal-left-panel');
      var rightPanel = leftPanel.nextElementSibling;
      var mainMediaContainer = document.getElementById('modal-main-media-container');
      var gallerySection = document.getElementById('modal-gallery-container');
      var galleryContainer = document.getElementById('modal-gallery');
      
      mainMediaContainer.innerHTML = '';
      galleryContainer.innerHTML = '';
      
      // 🌟 核心版面切換邏輯
      if (!hasContent && !hasGallery && mediaItems.length > 0) {
          // 模式 A：單圖或單影片 且【無內文】 -> 上下緊湊排版
          modalInner.className = "bg-white/95 backdrop-blur-md rounded-[2rem] max-w-2xl mx-auto w-full max-h-[90vh] overflow-y-auto md:overflow-hidden relative shadow-2xl flex flex-col transition-transform duration-300 scale-95 border border-white";
          leftPanel.className = "w-full bg-gray-100 flex flex-col items-center justify-center relative overflow-hidden shrink-0";
          
          // 關鍵修復：使用 flex-row 讓容器內的「標籤」與「標題+作者」強制併成完美的一行
          rightPanel.className = "w-full text-left p-4 md:p-6 bg-white flex flex-row flex-wrap items-center";
          
          catContainer.className = "mr-3"; // 取消原本的底部間距，改為右側間距
          modalTitle.className = "text-xl md:text-2xl font-bold text-morandi-dark leading-snug";
          
          leftPanel.style.display = 'flex';
          gallerySection.style.display = 'none';
      } else {
          // 模式 B：【有內文】 或 多圖 或 無圖 -> 恢復原本的左右分欄排版
          modalInner.className = "bg-white/95 backdrop-blur-md rounded-[2rem] max-w-5xl mx-auto w-full max-h-[90vh] overflow-y-auto md:overflow-hidden relative shadow-2xl flex flex-col md:flex-row transition-transform duration-300 scale-95 border border-white";
          leftPanel.className = "w-full md:w-2/5 max-h-[35vh] md:max-h-none bg-gray-50/50 flex flex-col items-center justify-center p-4 md:p-8 border-b md:border-b-0 md:border-r border-gray-200/50 relative overflow-hidden shrink-0";
          rightPanel.className = "w-full md:w-3/5 flex flex-col p-5 md:p-10 md:overflow-y-auto min-h-0 relative flex-1 text-left";
          
          catContainer.className = "mb-2 block";
          modalTitle.className = "text-2xl md:text-3xl font-bold text-morandi-dark mb-2 leading-snug block";
          
          if (mediaItems.length > 0) leftPanel.style.display = 'flex';
          else leftPanel.style.display = 'none';
      }
      
      // 媒體渲染
      if (mediaItems.length > 0) {
          var mainItem = mediaItems[0];
          var ytMinHeight = (!hasContent && !hasGallery) ? 'md:min-h-[450px]' : 'md:min-h-[350px]';
          
          if (mainItem.type === 'youtube') {
              var ytId = mainItem.embedUrl.match(/embed\/([^?]+)/)[1];
              mainMediaContainer.innerHTML = '<iframe src="https://www.youtube.com/embed/' + ytId + '?autoplay=1" class="w-full h-full min-h-[250px] ' + ytMinHeight + ' rounded-xl shadow-md" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
          } else {
              var mainLink = document.createElement('a');
              mainLink.setAttribute('data-fancybox', 'gallery-' + article.id);
              if (mainItem.caption) mainLink.setAttribute('data-caption', mainItem.caption);
              
              if (mainItem.type === 'drive_video') {
                  mainLink.href = mainItem.embedUrl;
                  mainLink.setAttribute('data-type', 'iframe');
                  mainLink.setAttribute('data-width', '1280'); mainLink.setAttribute('data-height', '720');
              } else { mainLink.href = mainItem.url; }
              
              mainLink.className = 'group relative w-full h-full flex items-center justify-center cursor-zoom-in';
              mainLink.innerHTML = '<img src="' + mainItem.thumbUrl + '" class="w-full h-auto object-contain max-h-[35vh] md:max-h-[70vh] drop-shadow-md group-hover:scale-105 transition-transform duration-500 rounded-xl" onerror="this.style.display=\'none\'">';
              mainMediaContainer.appendChild(mainLink);
          }
          
          if (hasGallery) {
              gallerySection.style.display = 'block';
              for (var i = 1; i < mediaItems.length; i++) {
                  var m = mediaItems[i];
                  var thumbLink = document.createElement('a');
                  thumbLink.setAttribute('data-fancybox', 'gallery-' + article.id);
                  if (m.caption) thumbLink.setAttribute('data-caption', m.caption);
                  if (m.type === 'youtube') {
                      var yId = m.embedUrl.match(/embed\/([^?]+)/)[1];
                      thumbLink.href = 'https://www.youtube.com/watch?v=' + yId + '&autoplay=1';
                  } else if (m.type === 'drive_video') {
                      thumbLink.href = m.embedUrl;
                      thumbLink.setAttribute('data-type', 'iframe');
                      thumbLink.setAttribute('data-width', '1280'); thumbLink.setAttribute('data-height', '720');
                  } else { thumbLink.href = m.url; }
                  thumbLink.className = 'relative aspect-square w-full rounded-xl overflow-hidden shadow-sm border border-gray-100 hover:border-gray-300 hover:shadow-md transition-all group flex items-center justify-center bg-gray-900 cursor-zoom-in';
                  var thumbHtml = '<img src="' + m.thumbUrl + '" class="w-full h-full object-cover group-hover:opacity-70 transition-opacity" onerror="this.style.display=\'none\'">';
                  if (m.type === 'youtube' || m.type === 'drive_video') {
                      thumbHtml += '<div class="absolute inset-0 bg-black/30 flex items-center justify-center"><svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>';
                  }
                  thumbLink.innerHTML = thumbHtml;
                  galleryContainer.appendChild(thumbLink);
              }
          }
      } else {
          // 完全沒有任何媒體時
          if (!hasContent) {
              modalInner.className = "bg-white/95 backdrop-blur-md rounded-[2rem] max-w-2xl mx-auto w-full overflow-hidden relative shadow-2xl flex flex-col transition-transform duration-300 scale-95 border border-white text-center";
              rightPanel.className = "w-full text-center p-6 md:p-10 bg-white flex flex-row flex-wrap items-center justify-center";
              catContainer.className = "mr-3";
              modalTitle.className = "text-xl md:text-2xl font-bold text-morandi-dark leading-snug";
          }
      }
      
      var modal = document.getElementById('article-modal'); 
      modal.style.display = 'flex'; 
      document.body.classList.add('modal-open');
      setTimeout(function() { 
        modal.classList.remove('opacity-0'); 
        var box = document.getElementById('modal-inner');
        if (box) box.classList.remove('scale-95');
      }, 10);
      
      history.pushState({ modalOpen: true }, "", "#article-" + articleId);
    }
    // ==========================================
    // 升級版：關閉彈窗 (結合平滑縮小動畫)
    // ==========================================
    function closeModal(isFromPopState) {
      var modal = document.getElementById('article-modal'); 
      var box = document.getElementById('modal-inner');
      
      modal.classList.add('opacity-0'); 
      if(box) box.classList.add('scale-95'); 
      
      setTimeout(function() { 
        modal.style.display = 'none'; 
        document.body.classList.remove('modal-open'); 
        
        // 清除背景 iframe 防止影片繼續出聲
        var iframes = document.getElementsByTagName('iframe');
        for (var i = 0; i < iframes.length; i++) { iframes[i].src = ''; }
      }, 300);

      if (isFromPopState !== true && history.state && history.state.modalOpen) {
          history.back();
      }
    }

    // ==========================================
    // 監聽手機返回鍵
    // ==========================================
    window.addEventListener('popstate', function(event) {
        var modal = document.getElementById('article-modal');
        // 如果按返回鍵的時候彈窗是開著的，就只關閉彈窗
        if (modal && modal.style.display === 'flex') {
            closeModal(true); 
        }
    });
   
function openLightbox(index) {
      if(currentGalleryData.length === 0) return;
      currentLightboxIndex = index;
      var tbContainer = document.getElementById('lightbox-thumbnails'); 
      tbContainer.innerHTML = '';
      
      currentGalleryData.forEach(function(data, i) {
        var thumbWrapper = document.createElement('div');
        thumbWrapper.id = 'lb-thumb-' + i;
        thumbWrapper.className = 'relative w-12 h-12 rounded-lg overflow-hidden transition-all duration-300 cursor-pointer flex-shrink-0 opacity-50 bg-gray-800 flex items-center justify-center';
        
        var html = '';
        if (data.thumbUrl) {
          html += '<img src="' + data.thumbUrl + '" class="w-full h-full object-cover" onerror="this.style.display=\'none\'">';
        }
        if (data.type === 'youtube' || data.type === 'drive_video') {
          html += '<div class="absolute inset-0 bg-black/40 flex items-center justify-center text-white"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>';
        }
        thumbWrapper.innerHTML = html;
        tbContainer.appendChild(thumbWrapper);
      });
      
      var lb = document.getElementById('lightbox'); 
      lb.style.display = 'flex'; 
      updateLightboxImage();
      setTimeout(function() { lb.classList.remove('opacity-0'); }, 10);

      // ★ 若點擊的是影片小方格，直接向瀏覽器請求進入系統級全螢幕 (支援電腦與 Android)
      var clickedItem = currentGalleryData[index];
      if (clickedItem && (clickedItem.type === 'youtube' || clickedItem.type === 'drive_video')) {
        try {
          if (lb.requestFullscreen) lb.requestFullscreen();
          else if (lb.webkitRequestFullscreen) lb.webkitRequestFullscreen();
        } catch (e) {}
      }
    }

    function closeLightbox() {
      // ★ 若目前處於系統全螢幕狀態，關閉燈箱時自動退出全螢幕
      try {
        if (document.fullscreenElement && document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitFullscreenElement && document.webkitExitFullscreen) document.webkitExitFullscreen();
      } catch (e) {}

      var lb = document.getElementById('lightbox'); 
      var lbImg = document.getElementById('lightbox-img');
      var videoBox = document.getElementById('lightbox-video-box');
      resetImageTransform(); 
      lb.classList.add('opacity-0'); 
      if (lbImg) { lbImg.style.transition = 'transform 0.3s ease'; lbImg.style.transform = 'scale(0.95)'; }
      setTimeout(function() { 
        lb.style.display = 'none'; 
        if (videoBox) { videoBox.innerHTML = ''; videoBox.style.display = 'none'; }
      }, 300);
    }

// ★ 點擊燈箱中央播放鈕後，啟動針對手機最佳化的防破版播放器
    window.startDriveVideo = function(fileId) {
      var container = document.getElementById('drive-player-inner');
      if (!container) return;
      
      // 判斷是否為手機小螢幕：手機版使用 200% 畫布 + scale(0.5) 徹底消除 iOS Safari 巨型控制列 Bug
      var isMobile = window.innerWidth < 768;
      var iframeStyle = isMobile 
        ? 'width:200%; height:200%; transform:scale(0.5); transform-origin:0 0; border:0; position:absolute; top:0; left:0;' 
        : 'width:100%; height:100%; border:0; position:absolute; top:0; left:0;';
      var clsMask = 'absolute top-0 right-0 w-14 h-14 bg-black z-20 pointer-events-auto select-none';
      
      container.innerHTML = [
        '<iframe src="https://drive.google.com/file/d/' + fileId + '/preview" style="' + iframeStyle + '" allow="autoplay; fullscreen" allowfullscreen></iframe>',
        '<div class="' + clsMask + '" onclick="event.stopPropagation(); return false;"></div>'
      ].join('');
    };

function updateLightboxImage() {
      resetImageTransform(); 
      var mainArea = document.getElementById('lightbox-main-area');
      var img = document.getElementById('lightbox-img'); 
      var videoBox = document.getElementById('lightbox-video-box');
      var captionEl = document.getElementById('lightbox-caption-text');
      var tbContainer = document.getElementById('lightbox-thumbnails');
      var currentData = currentGalleryData[currentLightboxIndex];
      
      if (videoBox) videoBox.innerHTML = '';

      if (currentData.type === 'youtube' || currentData.type === 'drive_video') {
        // ★ 影片滿版全螢幕模式：移除所有內距、隱藏下方縮圖列，讓影片 100% 佔滿整個視窗
        if (mainArea) mainArea.className = 'w-full h-full flex items-center justify-center overflow-hidden p-0';
        if (tbContainer) tbContainer.style.display = 'none';
        img.style.display = 'none';
        videoBox.style.display = 'flex';
        
        if (currentData.type === 'drive_video') {
          // 手機版針對滿版視窗採用 200% 畫布 + scale(0.5) 消除巨型時間軸，同時 100% 撐滿螢幕
          var isMobile = window.innerWidth < 768;
          var dStyle = isMobile 
            ? 'width:200%; height:200%; transform:scale(0.5); transform-origin:0 0; border:0; position:absolute; top:0; left:0;' 
            : 'width:100%; height:100%; border:0; position:absolute; top:0; left:0;';
          var maskCls = 'absolute top-0 right-0 w-16 h-16 bg-black z-20 pointer-events-auto select-none';
          
          videoBox.innerHTML = [
            '<div class="relative w-full h-full bg-black overflow-hidden">',
            '<iframe src="' + currentData.embedUrl + '" style="' + dStyle + '" allow="autoplay; fullscreen" allowfullscreen></iframe>',
            '<div class="' + maskCls + '" onclick="event.stopPropagation(); return false;"></div>',
            '</div>'
          ].join('');
        } else {
          // YouTube 滿版全螢幕播放
          var yStyle = 'width:100%; height:100%; border:0; position:absolute; top:0; left:0;';
          var yAllow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
          videoBox.innerHTML = [
            '<div class="relative w-full h-full bg-black overflow-hidden">',
            '<iframe src="' + currentData.embedUrl + '" style="' + yStyle + '" allow="' + yAllow + '" allowfullscreen></iframe>',
            '</div>'
          ].join('');
        }
      } else {
        // ★ 照片模式：恢復正常的邊距與底部縮圖列
        if (mainArea) mainArea.className = 'w-full h-full flex items-center justify-center overflow-hidden pb-32 px-3 md:px-8 pt-20';
        if (tbContainer) tbContainer.style.display = 'flex';
        if (videoBox) videoBox.style.display = 'none';
        img.style.display = 'block';
        img.style.transition = 'transform 0.1s ease'; 
        img.style.transform = 'scale(0.95)'; 
        img.src = currentData.url;
        setTimeout(function() { 
          img.style.transition = 'transform 0.3s ease'; 
          img.style.transform = 'scale(1)'; 
        }, 50);
      }

      if (currentData.caption && currentData.type === 'image') { 
        captionEl.innerText = currentData.caption; 
        captionEl.style.display = 'inline-block'; 
      } else { 
        captionEl.style.display = 'none'; 
      }
      
      var thumbActiveCls = 'relative w-12 h-12 rounded-lg overflow-hidden transition-all duration-300 cursor-pointer flex-shrink-0 opacity-100 ring-2 ring-white scale-110 bg-gray-800 flex items-center justify-center';
      var thumbIdleCls = 'relative w-12 h-12 rounded-lg overflow-hidden transition-all duration-300 cursor-pointer flex-shrink-0 opacity-50 bg-gray-800 flex items-center justify-center';
      
      document.getElementById('lightbox-counter').innerText = (currentLightboxIndex + 1) + ' / ' + currentGalleryData.length;
      currentGalleryData.forEach(function(_, i) {
        var thumb = document.getElementById('lb-thumb-' + i);
        if(thumb) {
          if (i === currentLightboxIndex) { 
            thumb.className = thumbActiveCls; 
            thumb.scrollIntoView({behavior: 'smooth', inline: 'center', block: 'nearest'}); 
          } else { 
            thumb.className = thumbIdleCls; 
          }
        }
      });
    }
   
    function prevImage() { if (currentLightboxIndex > 0) { currentLightboxIndex--; updateLightboxImage(); } }
    function nextImage() { if (currentLightboxIndex < currentGalleryData.length - 1) { currentLightboxIndex++; updateLightboxImage(); } }
    function showError(error) { document.getElementById('splash-loading').innerHTML = '<p class="text-red-500 font-bold text-center">載入失敗<br>請重新整理</p>'; }
  </script>
