    <div class="hidden md:flex mt-auto w-full pb-6 pt-4">
      <a href="https://script.google.com/a/macros/tmail.hc.edu.tw/s/AKfycbyirrh5kS5_rp8bgyqts7ciy_PaLOBgiK84H7WaAVtnYs1OkCT3c_Kdn57diJFt_B-2/exec" target="_blank" class="w-full flex items-center justify-center gap-2 bg-white/40 hover:bg-white/70 text-gray-500 hover:text-morandi-dark font-bold py-3 rounded-2xl transition-colors shadow-sm border border-white/50">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
        <span class="tracking-wider">後台管理</span>
